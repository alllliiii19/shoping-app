# Copy to .env and fill in the values
# Generate secrets with: openssl rand -hex 16 (password), openssl rand -hex 32 (JWT)

# Postgres container (creates these on first boot)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=shopping

# Backend container
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=shopping
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=
PORT=3000